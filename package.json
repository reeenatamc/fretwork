{
  "name": "tabs-repo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "generator, repo, printer for my guitar tabs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "check": "biome check src scripts && tsc --noEmit && npm run test",
    "test": "node --import tsx --test src/**/*.test.ts",
    "format": "biome check --write src scripts",
    "verify:alphatex": "node scripts/verify-alphatex.mjs"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.6.0",
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@coderline/alphatab-vite": "^1.6.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
